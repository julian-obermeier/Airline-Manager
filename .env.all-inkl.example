APP_NAME="Airline Empire"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://airline.obermeier-it.de
APP_TIMEZONE=Europe/Berlin

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Werte aus KAS -> Datenbanken übernehmen.
DB_CONNECTION=mysql
DB_HOST=DEIN_KAS_DATENBANK_HOST
DB_PORT=3306
DB_DATABASE=DEIN_KAS_DATENBANKNAME
DB_USERNAME=DEIN_KAS_DATENBANKBENUTZER
DB_PASSWORD=DEIN_KAS_DATENBANKPASSWORT
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_TIMEOUT=10

# Shared-Hosting-Profil: keine dauerhaft laufenden Hintergrunddienste erforderlich.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# E-Mail zunächst sicher ins Log schreiben. Vor produktivem Mailversand SMTP konfigurieren.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@airline.obermeier-it.de"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"
